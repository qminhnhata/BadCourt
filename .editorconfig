root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Consumed inside Linux containers: psql meta-commands such as \getenv would otherwise
# carry a trailing CR into the variable name, and the GitHub runner's shell would too.
[{db/init/*.sql,.github/workflows/*.yml,docker-compose.yml,*.sh}]
end_of_line = lf

[*.sql]
indent_size = 2

[*.cs]
indent_size = 4

# --- usings ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# --- language style ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# --- naming: interfaces prefixed with I ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

# --- naming: types and members are PascalCase ---
dotnet_naming_rule.types_are_pascal.severity = warning
dotnet_naming_rule.types_are_pascal.symbols = type_symbols
dotnet_naming_rule.types_are_pascal.style = pascal
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal.capitalization = pascal_case

# --- naming: fields ---
# Order matters: the first matching rule wins, so const and static readonly are claimed
# before the catch-all instance-field rule can demand an underscore on them.
dotnet_naming_rule.const_fields_are_pascal.severity = warning
dotnet_naming_rule.const_fields_are_pascal.symbols = const_field_symbols
dotnet_naming_rule.const_fields_are_pascal.style = pascal
dotnet_naming_symbols.const_field_symbols.applicable_kinds = field
dotnet_naming_symbols.const_field_symbols.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_are_pascal.severity = warning
dotnet_naming_rule.static_readonly_fields_are_pascal.symbols = static_readonly_field_symbols
dotnet_naming_rule.static_readonly_fields_are_pascal.style = pascal
dotnet_naming_symbols.static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbols.required_modifiers = static,readonly

# Private instance fields are _camelCase.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- analyzers we deliberately accept ---
# Each entry below is added by the step whose build it broke, never in advance.

# CA1716: cross-language keyword clashes. 'Error' is the standard name for this type in the
# Result pattern, and the codebase has no VB or F# consumers to protect.
dotnet_diagnostic.CA1716.severity = none

[tests/**/*.cs]
# CA1707: underscores in member names. Test methods are sentences, not API surface; the
# name is the specification and reads better with them.
dotnet_diagnostic.CA1707.severity = none
