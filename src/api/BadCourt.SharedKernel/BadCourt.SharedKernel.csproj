<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every setting is inherited from Directory.Build.props.

       The only references allowed here are the abstractions the dispatcher and its decorators
       are written against. Nothing that reaches a database, a broker or a network belongs in
       the kernel: modules depend on this assembly, so anything added here is added to all of
       them at once. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

</Project>
